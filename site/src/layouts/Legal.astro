---
import Base from './Base.astro';

interface Props { title: string; }
const { title } = Astro.props;
---
<Base lang="de" title={`${title} – Umut Aslan`} description={title} alternate="/en/">
  <article class="wrap legal">
    <a class="back" href="/">← Startseite</a>
    <h1>{title}</h1>
    <slot />
  </article>
</Base>

<style>
  .legal { max-width: 760px; padding-block: 56px 96px; }
  .back { color: var(--text-2); text-decoration: none; font-size: 0.9rem; }
  .back:hover { color: var(--accent); }
  h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 20px 0 32px; }
  .legal :global(h2) { font-size: 1.25rem; margin: 36px 0 10px; }
  .legal :global(p), .legal :global(li) { color: var(--text-2); }
  .legal :global(p + p) { margin-top: 12px; }
  .legal :global(address) { font-style: normal; color: var(--text); line-height: 1.8; }
  .legal :global(a) { color: var(--accent); }
</style>
