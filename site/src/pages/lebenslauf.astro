---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import me from '../assets/me.jpg';
import { profile, jobs, education, skills, languages, cvProjects } from '../data/content';

const period = (p: string) => (p.endsWith('–') ? `${p} heute` : p);
---
<Base lang="de" title="Lebenslauf – Umut Aslan" description="Lebenslauf von Umut Aslan, Full-Stack-Entwickler (C#, .NET, Angular, TypeScript)." alternate="/en/">
  <div class="toolbar wrap">
    <a href="/" class="back">← Startseite</a>
    <button class="btn btn-primary" type="button" onclick="window.print()">Drucken / als PDF speichern</button>
  </div>

  <article class="sheet">
    <header class="head">
      <div class="cv-band"><h1>{profile.name}</h1><p>Full-Stack-Entwickler · C# · .NET · Angular · TypeScript</p></div>
      <div class="bar"></div>
    </header>

    <div class="grid">
      <aside>
        <Image src={me} alt={profile.name} width={240} height={286} class="photo" />
        <h2>Kontakt</h2>
        <dl class="facts">
          <dt>E-Mail</dt><dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd>
          <dt>Web</dt><dd><a href="https://umut-aslan.dev">umut-aslan.dev</a></dd>
          <dt>GitHub</dt><dd><a href={profile.github}>Umut-Aslan99</a></dd>
          <dt>Ort</dt><dd>Dortmund · aus Bocholt</dd>
        </dl>
        <h2>Kenntnisse</h2>
        {skills.map((s) => <div class="skill"><h3>{s.group.de}</h3><p>{s.items.join(' · ')}</p></div>)}
        <h2>Sprachen</h2>
        <ul class="plain">{languages.map((l) => <li><strong>{l.name.de}</strong> – {l.level.de}</li>)}</ul>
        <h2>Interessen</h2>
        <p class="small">Spieleentwicklung, Klavier, Geocaching, Lesen, Fitnessstudio</p>
      </aside>

      <div class="main">
        <section>
          <h2>Profil</h2>
          <p>Full-Stack-Entwickler mit zwei Jahren Berufspraxis in C#/.NET und Angular. Ich übernehme Projekte von der Anforderung bis zum Betrieb: eigene Anwendungen konzipiert, getestet, containerisiert und veröffentlicht. KI-Werkzeuge setze ich gezielt ein – mit Tests, Code Reviews und klarer Architektur als Sicherung. Live-Demos aller Projekte unter <a href="https://umut-aslan.dev">umut-aslan.dev</a>.</p>
        </section>

        <section>
          <h2>Berufserfahrung</h2>
          {jobs.map((j) => (
            <div class="entry">
              <span class="when">{period(j.period)}</span>
              <div>
                <h3>{j.role.de}</h3>
                <p class="org">{j.org}{j.place && ` · ${j.place}`}</p>
                <ul>{j.points.de.map((p) => <li>{p}</li>)}</ul>
              </div>
            </div>
          ))}
        </section>

        <section>
          <h2>Ausbildung</h2>
          {education.map((e) => (
            <div class="entry"><span class="when">{e.period.de}</span><div><h3>{e.title.de}</h3><p class="org">{e.org}</p></div></div>
          ))}
        </section>

        <section class="projects">
          <h2>Projekte</h2>
          {cvProjects.map((p) => (
            <div class="proj"><h3>{p.title} <span>{p.tag}</span></h3><p>{p.text}</p></div>
          ))}
        </section>
      </div>
    </div>
  </article>
</Base>

<style>
  .toolbar { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-block: 28px; }
  .back { color: var(--text-2); text-decoration: none; }
  .sheet {
    max-width: 210mm; margin: 0 auto 80px; background: #fff; color: #1a1a1a; box-shadow: var(--shadow);
    border-radius: 6px; overflow: hidden; font-size: 10pt; line-height: 1.45;
  }
  .cv-band { background: #000; color: #f4f1ea; padding: 26px 32px 18px; }
  .cv-band h1 { font-size: 24pt; letter-spacing: -0.02em; }
  .cv-band p { color: #c9c5bc; margin-top: 4px; font-size: 10pt; }
  .bar { height: 7px; width: 40%; background: #e8834a; }
  .grid { display: grid; grid-template-columns: 62mm 1fr; }
  aside { background: #f6f3ec; padding: 22px 20px 28px; }
  .main { padding: 18px 28px 28px; }
  .main section { padding: 0; }
  h2 {
    font: 600 10.5pt/1 var(--font-display); font-variant: small-caps; letter-spacing: 0.08em; color: #1a1a1a;
    border-bottom: 1px solid #c9c5bc; padding-bottom: 5px; margin: 18px 0 10px;
  }
  h3 { font: 600 10pt/1.3 var(--font-display); margin: 0; }
  .photo { width: 100%; height: auto; border-radius: 4px; display: block; }
  .facts { display: grid; grid-template-columns: auto 1fr; gap: 3px 10px; margin: 0; font-size: 8.5pt; }
  .facts dt { color: #6f7352; }
  .facts dd { margin: 0; word-break: break-all; }
  a { color: inherit; }
  .skill { margin-bottom: 8px; }
  .skill h3 { font: 500 7.5pt/1.2 var(--font-mono); text-transform: uppercase; letter-spacing: 0.06em; color: #6f7352; }
  .skill p, .small, .plain { font-size: 8.5pt; }
  .plain { list-style: none; padding: 0; margin: 0; display: grid; gap: 3px; }
  .entry { display: grid; grid-template-columns: 30mm 1fr; gap: 10px; margin-bottom: 12px; break-inside: avoid; }
  .when { color: #6f7352; font: 8.5pt/1.5 var(--font-mono); }
  .org { color: #4a4740; }
  .entry ul { margin: 5px 0 0; padding-left: 15px; }
  .entry li::marker { color: #e8834a; }
  .proj { margin-bottom: 9px; break-inside: avoid; }
  .proj h3 span { font: 400 7.5pt var(--font-mono); color: #6f7352; margin-left: 6px; }
  .proj p { font-size: 9pt; color: #333; }

  @media (max-width: 720px) {
    .grid { grid-template-columns: 1fr; }
    .entry { grid-template-columns: 1fr; gap: 2px; }
    .photo { max-width: 180px; }
  }

  @media print {
    @page { size: A4; margin: 14mm 0 12mm; }
    @page :first { margin-top: 0; }
    :global(body) { background: #fff !important; }
    :global(.band), :global(.foot), :global(.skip), .toolbar { display: none !important; }
    .sheet { box-shadow: none; border-radius: 0; margin: 0; max-width: none; }
    .grid { grid-template-columns: 62mm 1fr; }
    :global(.js) :global(.reveal) { opacity: 1 !important; transform: none !important; }
  }
</style>
