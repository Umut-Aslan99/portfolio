---
import Icon from './Icon.astro';
import { t, jobs, education, skills, languages, type Lang } from '../data/content';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = t[lang].cv;
const period = (p: string) => (p.endsWith('–') ? `${p} ${c.now}` : p);
---
<section id="cv" aria-labelledby="cv-title">
  <div class="wrap">
    <p class="eyebrow reveal"><b>05</b>{c.title}</p>
    <h2 id="cv-title" class="sr-only">{c.title}</h2>
    <a class="btn cv-link reveal" href="/lebenslauf/">{c.download}<Icon name="arrow" /></a>

    <div class="layout">
      <div class="main">
        <h3 class="rule reveal">{c.work}</h3>
        <ol class="timeline">
          {jobs.map((j, i) => (
            <li class="row reveal" style={`--i:${i}`}>
              <span class="when mono">{period(j.period)}</span>
              <div class="what">
                <h4>{j.role[lang]}</h4>
                <p class="org">{j.org}{j.place && <span> · {j.place}</span>}</p>
                <ul>{j.points[lang].map((pt) => <li>{pt}</li>)}</ul>
                {j.stack && <div class="chips">{j.stack.map((s) => <span class="chip">{s}</span>)}</div>}
              </div>
            </li>
          ))}
        </ol>

        <h3 class="rule reveal">{c.edu}</h3>
        <ol class="timeline">
          {education.map((e) => (
            <li class="row reveal">
              <span class="when mono">{e.period[lang]}</span>
              <div class="what"><h4>{e.title[lang]}</h4><p class="org">{e.org}</p></div>
            </li>
          ))}
        </ol>
      </div>

      <aside class="side">
        <h3 class="rule reveal">{c.skills}</h3>
        <div class="skills">
          {skills.map((s, i) => (
            <div class="reveal" style={`--i:${i}`}>
              <h4>{s.group[lang]}</h4>
              <div class="chips">{s.items.map((x) => <span class="chip">{x}</span>)}</div>
            </div>
          ))}
        </div>

        <h3 class="rule reveal">{c.langs}</h3>
        <ul class="langs reveal">
          {languages.map((l) => (
            <li>
              <div class="lrow"><strong>{l.name[lang]}</strong><span>{l.level[lang]}</span></div>
              <div class="meter" role="presentation"><span style={`--w:${l.pct}%`}></span></div>
            </li>
          ))}
        </ul>

        <h3 class="rule reveal">{c.about}</h3>
        <p class="about reveal">{c.aboutText}</p>
      </aside>
    </div>
  </div>
</section>

<style>
  .cv-link { margin-top: 28px; }
  .layout { display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(40px, 6vw, 80px); margin-top: 40px; }
  /* CV-style headings: small caps, centered on a hairline. */
  .rule {
    font: 600 0.95rem/1 var(--font-display); font-variant: small-caps; letter-spacing: 0.08em;
    text-align: center; padding-bottom: 8px; border-bottom: 1px solid var(--line-strong); margin: 0 0 28px;
  }
  .timeline + .rule, .skills + .rule, .langs + .rule { margin-top: 48px; }
  .timeline { list-style: none; padding: 0; margin: 0; display: grid; gap: 34px; }
  .row { display: grid; grid-template-columns: 150px 1fr; gap: 20px; }
  .when { font-size: 0.8rem; color: var(--muted); padding-top: 4px; }
  h4 { font: 600 1.1rem/1.3 var(--font-display); margin: 0; }
  .org { color: var(--text-2); font-size: 0.92rem; margin-top: 2px; }
  .what ul { margin: 12px 0 0; padding-left: 18px; display: grid; gap: 6px; }
  .what li { font-size: 0.93rem; }
  .what li::marker { color: var(--accent); }
  .what .chips { margin-top: 14px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }

  .skills { display: grid; gap: 20px; }
  .skills h4 { font-size: 0.8rem; font-family: var(--font-mono); font-weight: 500; color: var(--muted); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.08em; }
  .langs { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; }
  .lrow { display: flex; justify-content: space-between; gap: 12px; font-size: 0.92rem; }
  .lrow span { color: var(--text-2); font-size: 0.84rem; text-align: right; }
  .meter { height: 4px; background: var(--surface-2); border-radius: 4px; margin-top: 8px; overflow: hidden; }
  .meter span { display: block; height: 100%; width: var(--w); background: var(--accent); border-radius: 4px; transform-origin: left; transition: transform 1.2s var(--ease) 0.2s; }
  :global(.js) .langs:not(:global(.in)) .meter span { transform: scaleX(0); }
  .about { color: var(--text-2); font-size: 0.95rem; }

  @media (max-width: 900px) { .layout { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .row { grid-template-columns: 1fr; gap: 6px; } }
</style>
